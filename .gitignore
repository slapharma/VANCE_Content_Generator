node_modules/
.env.local
.vercel/
.vercel
.env*.local
.worktrees/
.env.production

# Audit dumps and one-off operational files — NEVER commit (may contain secrets)
.env*.audit
*.audit
fix-env-secrets.sh

# Local-only assets / screenshots
hcp-desktop-full.png

# Local Claude config (per-machine, may contain settings/credentials)
.claude/

.env.prod.fresh

# Large content/data dumps — never commit, never ship to Vercel (bloats deploy)
articles-backup-*.json
*-backup-*.json

# Stray local working dirs
sla-customizer-edits-*/
tasks/

# Reformat script output (before/after dumps, backups)
scripts/reformat-out/
# Vercel env dumps (vercel env pull > sec-*.txt) — real keys in plaintext.
# Not matched by the .env rules above, which is how three of these once sat
# untracked in the estate one 'git add -A' from being published.
sec-*.txt
_harness.html
